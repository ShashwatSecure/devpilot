# --- Google Gemini ------------------------------------------------------------
# Keep these names aligned with backend/src/main/resources/application.yaml.
GOOGLE_GENAI_API_KEY=
GOOGLE_GENAI_CHAT_MODEL=gemini-3.8-flash

# --- Agent behaviour -------------------------------------------------------------
MAX_REVIEW_ITERATIONS_DEFAULT=2

# --- Networking --------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# --- Security ------------------------------------------------------------------------
# Shared secret the Java backend must send as X-Agent-Service-Key. Leave blank only for
# local docker-compose on a private network; set it for anything else.
AGENT_SERVICE_API_KEY=
