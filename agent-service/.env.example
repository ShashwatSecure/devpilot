# --- Google Gemini (generation only) --------------------------------------------
GOOGLE_GENAI_API_KEY=
GOOGLE_GENAI_CHAT_MODEL=gemini-3.8-flash

# --- Agent behaviour -------------------------------------------------------------
MAX_REVIEW_ITERATIONS_DEFAULT=2

# --- Database (docker-compose overrides this to point at the postgres service) --
DATABASE_URL=postgresql+asyncpg://devpilot:devpilot@localhost:5432/devpilot

# --- Local embeddings (must match the `embeddings` table's vector column size) --
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMENSION=1024

# --- Guest sessions ----------------------------------------------------------------
SESSION_SECRET=change-me
